# LLM API Configuration (OpenAI API compatible endpoint)
# Supports: OpenAI, Azure OpenAI, vLLM, Ollama, LocalAI, LM Studio, etc.
LOCAL_LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# CORS Configuration (comma-separated list)
ALLOWED_ORIGINS=http://localhost:3000

# Subdirectory deployment (leave empty for root deployment)
# Example: /chatbot (must start with / if set)
BASE_PATH=
